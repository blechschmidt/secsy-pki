# Keep the build context small and reproducible. Only server/ sources are needed
# by the Dockerfile; everything else is docs, local state, or tooling.
.git
.github
.cloop
docs
terraform
test-ssh
deploy
scripts
*.md

# …except the two deployment files the `-yubihsm` build needs: the host udev
# rule, which the image ships under /usr/share so the rule and the software that
# needs it come from the same place, and the OpenPGP key the build stage checks
# Yubico's release tarball against. Re-including a path under an excluded
# directory works here in a way it would not in .gitignore — Docker applies the
# patterns in order and does descend to find the exception.
!deploy/udev/70-yubihsm.rules
!deploy/yubihsm/yubico-release-signing-key.asc

# Local/build state that must never leak into an image layer.
server/secsy-pki.db
server/secsy-pki.db-shm
server/secsy-pki.db-wal
server/secsy-pki-server
server/ssh-pki-server
server/ssh-pki.db*
server/certs
server/keystore
**/*.exe
