# Example configuration for running secsy-pki against a SoftHSM2 token.
#
# Set up the token first:
#   ./scripts/setup-softhsm.sh
# Then either edit the pkcs11 block below to match the script's output, or leave
# it empty and export the environment instead:
#   eval "$(./scripts/setup-softhsm.sh --export-env)"
# The SECSY_PKCS11_MODULE / SECSY_TOKEN_LABEL / SECSY_USER_PIN variables that the
# script exports override the pkcs11 values here at load time.

server:
  host: "0.0.0.0"
  port: 8443
  # Omit tls_cert/tls_key to serve plain HTTP for local development.

# gRPC API surface (Task 56): expose the core issuance/revocation/status
# operations over gRPC alongside REST. Disabled by default. It reuses
# server.tls_cert/tls_key unless grpc.tls_cert/tls_key are set, and requires TLS
# unless SECSY_ALLOW_INSECURE_HTTP=1. See docs/grpc-api.md.
grpc:
  enabled: false
  address: ":9443"
  # mtls: true   # request + bind mutual-TLS client certs (requires auth.mtls)

database:
  driver: "sqlite"
  dsn: "secsy-pki.db"

oidc:
  issuer_url: ""

root_user:
  username: "root"
  password: "change-me-in-production"

key_provider:
  type: "pkcs11"

pkcs11:
  # These default to the values from scripts/setup-softhsm.sh. They are
  # overridden by SECSY_* environment variables when those are exported.
  module_path: "/usr/lib/softhsm/libsofthsm2.so"
  pin: "1234"
  token_label: "secsy-pki-root"

# HSM-backed envelope encryption for passwords / secrets (secsy-secret CLI and
# /api/secret/* endpoints). kek_label names the RSA key-encryption key that
# wraps per-message data keys; create it with:  secsy-secret init-kek
# Leave empty to disable the secret encrypt/decrypt API.
secret:
  kek_label: "secsy-kek"

# ACME (RFC 8555) automated issuance for certbot / lego / acme.sh. Disabled
# unless enabled=true. Point it at an existing X.509 issuing CA (create one with
# secsy-ca) and a certificate profile. See docs/acme.md for the full guide.
acme:
  enabled: false
  # base_url: "https://pki.example.com"   # or derived from the request Host
  ca_label: "Secsy Issuing CA"            # the CA that signs ACME certs
  profile: "server"                       # the ACME-enabled profile
  challenge_types: ["http-01", "dns-01"]
  # require_eab: true                     # restrict who may register (RBAC-like)
  # eab_hmac_keys:
  #   team-web: "base64url-or-base64-hmac-key"

# SCEP (RFC 8894) device / MDM enrollment. Disabled unless enabled=true. The
# issuing CA MUST be an RSA CA (SCEP wraps requests in a PKCS#7 EnvelopedData
# using RSA key transport). A dedicated, decrypt-capable RA encryption key is
# auto-provisioned on the HSM on first use. See docs/enrollment.md.
scep:
  enabled: false
  ca_label: "Secsy Issuing CA"            # must be an RSA CA
  profile: "client"                       # default profile for enrolled devices
  # require_challenge: true               # require a matching grant challenge (default)
  # allow_renewal: true                   # challenge-free renewal with a valid issued cert
  grants:
    - name: "fleet-a"                      # operator-provisioned enrollment credential
      challenge: "change-me-shared-secret"
      profile: "client"

# EST (RFC 7030) device / MDM enrollment over TLS. Disabled unless enabled=true.
# Authenticate with HTTP Basic (users below) or a TLS client certificate this CA
# previously issued (allow_tls_client_reenroll). See docs/enrollment.md.
est:
  enabled: false
  ca_label: "Secsy Issuing CA"            # any key type
  profile: "client"
  # allow_tls_client_reenroll: true       # accept a prior client cert for (re)enroll
  # enable_server_keygen: true            # POST /serverkeygen returns a generated key
  users:
    device01:
      password: "change-me"
      profile: "client"
