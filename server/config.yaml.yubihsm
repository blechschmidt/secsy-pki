server:
  host: "0.0.0.0"
  port: 8443
  tls_cert: "certs/server.crt"
  tls_key: "certs/server.key"

database:
  driver: "sqlite"
  dsn: "ssh-pki.db"

oidc:
  issuer_url: "http://localhost:8080/realms/secsy-pki"
  client_id: "ssh-pki"
  client_secret: "change-me"
  redirect_url: "https://localhost:8443/api/auth/callback"

root_user:
  username: "root"
  password: "change-me-in-production"

# YubiHSM2 via yubihsm-connector
# Ensure YUBIHSM_PKCS11_CONF is set and yubihsm-connector is running
pkcs11:
  module_path: "/usr/lib/pkcs11/yubihsm_pkcs11.so"
  pin: "0001password"
  token_label: "YubiHSM"

# HSM-backed envelope encryption for passwords / secrets (secsy-secret CLI and
# /api/secret/* endpoints). kek_label names the RSA key-encryption key that
# wraps per-message data keys; create it with:  secsy-secret init-kek
# Leave empty to disable the secret encrypt/decrypt API.
secret:
  kek_label: "secsy-kek"
