# Copy to .env and change every value. Compose reads .env from this directory
# automatically; the stack refuses to start if any required variable is missing
# rather than defaulting to something guessable.
#
#   cp .env.example .env
#   ./device-env.sh >> .env      # appends the two device lines below
#
# .env is gitignored. config.yaml holds no secrets and no host-specific paths,
# which is what lets it stay in version control and be mounted read-only.

# --- the device ---------------------------------------------------------------

# The USB node the YubiHSM is on, and the numeric gid of that node's group.
# `./device-env.sh` finds both. They change when the device is re-enumerated —
# a replug, a reboot, a USB/IP attach — so re-run it if the stack stops seeing
# the HSM. Install deploy/udev/70-yubihsm.rules on the host so the node has a
# stable group that the container can be added to.
SECSY_YUBIHSM_DEVICE=/dev/bus/usb/003/002
SECSY_YUBIHSM_DEVICE_GID=0

# --- required -----------------------------------------------------------------

# The YubiHSM authentication key id and its password, used by the native driver
# (audit-log collection, attestation, device commitments).
SECSY_YUBIHSM_AUTH_KEY_ID=1
SECSY_YUBIHSM_PASSWORD=change-me-device-password

# The same credential in PKCS#11 form, used for signing: the 4-digit auth key
# id followed by the password. Key 1 with password "hunter2" is "0001hunter2".
# The module takes it as one string, which is why it is a second variable rather
# than something the stack can derive for you without re-encoding a secret.
SECSY_USER_PIN=0001change-me-device-password

# Initial superuser password for the API and the web console (username "root").
SECSY_ROOT_PASSWORD=change-me-root-password

# --- where the device audit log goes -------------------------------------------

# The container path the collected device log is appended to, and the host
# directory mounted at /app/audit for it to land in.
#
# The default is the file below inside a Docker-managed `audit` volume, which
# survives the container but not the host. Name a host directory to put the log
# somewhere this deployment cannot rewrite — an append-only directory, a WORM
# mount, a log shipper's spool. That is the whole reason for a copy outside the
# database, so on a force-audited device it is worth the two lines:
#
#   sudo install -d -o 65532 -g 65532 /srv/secsy-audit
#   sudo chattr +a /srv/secsy-audit/device-log.jsonl   # after the first start
#
# The server opens the path at startup and refuses to start if it cannot append
# to it, so a wrong owner or a read-only mount is a boot failure naming the
# path rather than a surprise at the first drain.
#SECSY_AUDIT_DIR=/srv/secsy-audit
#SECSY_YUBIHSM_AUDIT_LOG_FILE=/app/audit/device-log.jsonl

# --- optional -----------------------------------------------------------------

# Image tag. The stack appends "-yubihsm" to it, and every published tag has a
# counterpart built from the same commit in the same job.
#
# `edge` is the head of main, which is what exists before this project cuts a
# release — so it is the value here rather than a commented-out suggestion: a
# fresh copy of this file has to bring the stack up, and `latest` is published
# only by a release. Change it to a release tag for anything you intend to keep;
# `edge` and `latest` both move under you.
SECSY_TAG=edge

# Image repository, for running a local build rather than the published one.
#SECSY_IMAGE=ghcr.io/blechschmidt/secsy-pki

# Host port for the HTTPS listener.
#SECSY_HTTPS_PORT=8443

# Whether the server multiplexes the device inside its own process, which is
# what makes this a single container: it takes the one USB claim and serves
# Yubico's connector protocol on loopback for the PKCS#11 module, while the
# audit driver uses the same claim directly. docker-compose.yaml sets it to 1
# explicitly; it is also the default for this configuration. Set it to 0 only
# with docker-compose.connector.yaml, where Yubico's daemon owns the device.
#SECSY_YUBIHSM_EMBEDDED_CONNECTOR=1

# The address it serves, if 127.0.0.1:12345 is taken inside the container.
# Change SECSY_YUBIHSM_CONNECTOR_URL in docker-compose.yaml to match.
#SECSY_YUBIHSM_EMBEDDED_CONNECTOR_LISTEN=127.0.0.1:12345
