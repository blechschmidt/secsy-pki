      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Certificates in expiry window by severity",
      "description": "As of the last monitor scan: warning|critical|expired counts. A rising 'expired' or 'critical' line is an issuance/renewal backlog.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 66 },
      "id": 50,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15 },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (severity) (secsy_certificates_expiring{job=~\"$job\"})", "legendFormat": "{{severity}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Auto-renewals / sec by result",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 66 },
      "id": 51,
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (result) (rate(secsy_certificate_auto_renewals_total{job=~\"$job\"}[15m]))", "legendFormat": "{{result}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
