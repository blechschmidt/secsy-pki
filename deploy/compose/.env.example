# Copy to .env and change every value. Compose reads .env from this directory
# automatically; the stack refuses to start if any of the three required
# variables is missing, rather than defaulting to something guessable.
#
#   cp .env.example .env
#
# .env is gitignored. Keeping these out of config.yaml is the point: that file
# holds no secrets and is mounted read-only, so it can live in version control
# while the PIN and the password come from wherever your deployment keeps
# secrets. In production that is a secret manager, not a file —
# docs/hsm/pin-sourcing.md covers sourcing the PIN from Vault, AWS/Azure/GCP or a
# mode-0600 file instead.

# --- required -----------------------------------------------------------------

# PKCS#11 user PIN. For SoftHSM this is whatever you choose here; for a real HSM
# it is the token's existing PIN, and this stack must not be the thing that
# decides it.
SECSY_USER_PIN=change-me-user-pin

# PKCS#11 security-officer PIN. Used once, to initialize the SoftHSM token; not
# needed afterwards and never used by the server.
SECSY_SO_PIN=change-me-so-pin

# Initial superuser password for the API and the web console (username "root").
# Reachable from anywhere the published port is, so treat it accordingly; see
# docs/security/authentication.md for turning it off once real operators exist.
SECSY_ROOT_PASSWORD=change-me-root-password

# --- optional -----------------------------------------------------------------

# Image tag. Pin a release (e.g. 1.2.3) for anything you intend to keep; `latest`
# moves under you. `edge` is the head of main.
#SECSY_TAG=latest

# Image repository, for running a build that is not the published one. `make
# image` builds ghcr.io/blechschmidt/secsy-pki:<git-describe>, so for that only
# SECSY_TAG needs setting; SECSY_IMAGE is for a differently-named local build.
#SECSY_IMAGE=ghcr.io/blechschmidt/secsy-pki

# Host port for the HTTPS listener.
#SECSY_HTTPS_PORT=8443

# PostgreSQL overlay only (docker-compose.postgres.yaml).
#POSTGRES_PASSWORD=change-me-db-password
#POSTGRES_USER=secsy
#POSTGRES_DB=secsy_pki
